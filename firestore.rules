rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Content is read-only for clients; published via admin tooling.
    match /content/{document=**} { allow read: if signedIn(); allow write: if false; }
    match /story/{document=**}   { allow read: if signedIn(); allow write: if false; }
    match /games/{id}            { allow read: if signedIn(); allow write: if false; }

    // Beta: the owner writes their own profile (no Cloud Functions yet), so
    // scores are not cheat-proof. Move xp/coins writes server-side before launch.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'xp', 'coins', 'streak', 'level', 'blob', 'updatedAt'])
        && request.resource.data.xp is int && request.resource.data.xp >= 0
        && request.resource.data.coins is int && request.resource.data.coins >= 0
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.blob is string && request.resource.data.blob.size() < 50000;
    }

    match /leaderboards/{period}/entries/{uid} { allow read: if signedIn(); allow write: if false; }
  }
}
